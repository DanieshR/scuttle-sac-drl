<?xml version="1.0" ?>
<!-- Gazebo Classic (gazebo11) plugin definitions for SCUTTLE.
     Replaces the gz-sim-* plugins used in the Gazebo Harmonic version. -->
<robot name="scuttle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── Friction properties ──────────────────────────────────────────── -->
  <gazebo reference="chassis_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="l_wheel">
    <material>Gazebo/Blue</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
  </gazebo>

  <gazebo reference="r_wheel">
    <material>Gazebo/Blue</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
  </gazebo>

  <gazebo reference="l_caster_swivel">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo reference="r_caster_swivel">
    <material>Gazebo/Grey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>

  <gazebo reference="l_caster_wheel">
    <material>Gazebo/Blue</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
  </gazebo>

  <gazebo reference="r_caster_wheel">
    <material>Gazebo/Blue</material>
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
  </gazebo>

  <!-- ── Differential Drive ────────────────────────────────────────────
       libgazebo_ros_diff_drive.so publishes /odom and subscribes /cmd_vel
       and optionally broadcasts odom→base_link TF directly.             -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros/>

      <update_rate>30</update_rate>

      <left_joint>l_wheel_joint</left_joint>
      <right_joint>r_wheel_joint</right_joint>

      <wheel_separation>0.4247</wheel_separation>
      <wheel_diameter>0.0833</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ── Joint State Publisher ─────────────────────────────────────── -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <remapping>~/out:=/joint_states</remapping>
      </ros>
      <update_rate>10</update_rate>
      <joint_name>l_wheel_joint</joint_name>
      <joint_name>r_wheel_joint</joint_name>
      <joint_name>l_caster_swivel_joint</joint_name>
      <joint_name>r_caster_swivel_joint</joint_name>
      <joint_name>l_caster_wheel_joint</joint_name>
      <joint_name>r_caster_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ── LiDAR (ray sensor — CPU, no display required) ───────────────
       Publishes sensor_msgs/LaserScan on /scan at 10 Hz.
       Matching LD19 sim parameters: 360 samples, 0.12–10 m range.     -->
  <gazebo reference="base_scan">
    <sensor type="ray" name="ydlidar_x4">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>5.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>40</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>3.5</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <argument>~/out:=/scan</argument>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
