<?xml version="1.0" ?>
<robot name="scuttle" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find scuttle_description)/urdf/materials.xacro" />
    <xacro:include filename="$(find scuttle_description)/urdf/scuttle.trans" />
    <xacro:include filename="$(find scuttle_description)/urdf/scuttle.gazebo" />

    <link name="base_link"/>

    <joint name="chassis_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0.25075 0 0.084749938964843793"/>
        <parent link="base_link"/>
        <child link="chassis_link"/>
    </joint>

    <link name="chassis_link">
        <inertial>
            <origin xyz="-0.15472 0.11007 0.0067461" rpy="0 0 0" />
            <mass value="1.314" />
            <inertia ixx="0.0025673" ixy="-2.165E-07" ixz="-3.2707E-06" iyy="0.0019434" iyz="1.4947E-07" izz="0.0042618" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/chassis_link.STL" scale="1 1 1"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/chassis_link.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="l_wheel_joint" type="continuous">
        <origin xyz="-0.25075 -0.07277 -0.0255" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="l_wheel"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="l_wheel">
        <inertial>
            <origin xyz="3.6753910526155E-08 0.379920381390465 4.1744959514145E-07" rpy="0 0 0" />
            <mass value="0.283794330016012" />
            <inertia ixx="0.000200549433706374" ixy="-9.89319448183521E-10" ixz="-5.86027651127705E-10" iyy="0.000230387381127549" iyz="7.09952209978501E-10" izz="0.000200549153406663" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_wheel.STL" scale="1 1 1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_wheel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="r_wheel_joint" type="continuous">
        <origin xyz="-0.25075 0.31127 -0.0255" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="r_wheel"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="r_wheel">
        <inertial>
            <origin xyz="-3.67532115297386E-08 -0.379920381376333 4.17450763720573E-07" rpy="0 0 0" />
            <mass value="0.283794330161645" />
            <inertia ixx="0.000200549433787431" ixy="-9.89320765409997E-10" ixz="5.8601972536345E-10" iyy="0.000230387381128946" iyz="-7.09954783134225E-10" izz="0.000200549153475484" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_wheel.STL" scale="1 1 1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_wheel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="scan_joint" type="fixed">
        <origin xyz="0.00825 0.11925 0.062025" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="base_scan"/>
    </joint>

    <link name="base_scan">
        <inertial>
            <origin xyz="5.05625054968151E-05 -1.82810742067424E-07 -0.0143142680812563" rpy="0 0 0" />
            <mass value="0.0511626081585212" />
            <inertia ixx="9.4431726896802E-06" ixy="1.16370902778088E-07" ixz="1.19194919052246E-08" iyy="7.44580899433581E-06" iyz="7.67735240903272E-11" izz="1.46833890387608E-05" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/lidar_1.STL" scale="1 1 1"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/lidar_1.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="l_caster_swivel_joint" type="continuous">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="l_caster_swivel"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="l_caster_swivel">
        <inertial>
            <origin xyz="-0.00238003497237424 -0.000527953313655571 -0.00772671935388341" rpy="0 0 0" />
            <mass value="0.183282825967115" />
            <inertia ixx="2.91526534427435E-05" ixy="-1.53768220855742E-10" ixz="-2.67813392257543E-06" iyy="2.92466395062805E-05" iyz="2.48844541083131E-10" izz="4.27585384079886E-05" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_caster_swivel.STL" scale="1 1 1"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_caster_swivel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="l_caster_wheel_joint" type="continuous">
        <origin xyz="-0.0234 0 -0.0435" rpy="0 0 0" />
        <parent link="l_caster_swivel"/>
        <child link="l_caster_wheel"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="l_caster_wheel">
        <inertial>
            <origin xyz="-2.77555756156289E-17 2.77555756156289E-17 6.93889390390723E-18" rpy="0 0 0" />
            <mass value="0.034306971498681" />
            <inertia ixx="6.0005051056636E-06" ixy="5.84206171313588E-22" ixz="-5.93592027393262E-25" iyy="1.00026864795821E-05" iyz="-1.07427123594847E-21" izz="6.0005051056636E-06" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_caster_wheel.STL" scale="1 1 1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_caster_wheel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="r_caster_swivel_joint" type="continuous">
        <origin xyz="0 0.2385 0" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="r_caster_swivel"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="r_caster_swivel">
        <inertial>
            <origin xyz="-0.00238003497237435 0.000563596168910621 -0.00772671935388337" rpy="0 0 0" />
            <mass value="0.183282825967115" />
            <inertia ixx="2.91526534427435E-05" ixy="-1.53768220867403E-10" ixz="-2.67813392257511E-06" iyy="2.92466395062278E-05" iyz="2.48844541032968E-10" izz="4.27585384079358E-05" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_caster_swivel.STL" scale="1 1 1"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_caster_swivel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="r_caster_wheel_joint" type="continuous">
        <origin xyz="-0.0234 0 -0.0435" rpy="0 0 0" />
        <parent link="r_caster_swivel"/>
        <child link="r_caster_wheel"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="r_caster_wheel">
        <inertial>
            <origin xyz="-2.77555756156289E-17 -1.38777878078145E-17 6.93889390390723E-18" rpy="0 0 0" />
            <mass value="0.034306971498681" />
            <inertia ixx="6.0005051056636E-06" ixy="1.41820411380178E-22" ixz="9.344028433006E-25" iyy="1.00026864795821E-05" iyz="-1.69349177229285E-22" izz="6.0005051056636E-06" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_caster_wheel.STL" scale="1 1 1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_caster_wheel.STL" scale="1 1 1"/>
            </geometry>
