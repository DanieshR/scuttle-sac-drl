<?xml version="1.0" ?>
<!--
  SCUTTLE robot — Gazebo Classic (gazebo11) native SDF
  Geometry derived from the user's ROS2 Jazzy XACRO (Desktop/scuttle_description).
  Link poses are in model frame (SDF 1.6 default, not relative to parent).

  Key positions (model frame, base_footprint/base_link at z=0):
    chassis_link   :  ( 0.25075,  0.00000, 0.08475)
    l_wheel joint  :  ( 0.00000, -0.07277, 0.05925)  wheel rim at y+0.38 in link frame
    r_wheel joint  :  ( 0.00000,  0.31127, 0.05925)  wheel rim at y-0.38 in link frame
    lidar_1        :  ( 0.25900,  0.11925, 0.14678)  chassis + lidar_joint offsets
    l_caster_swivel:  ( 0.25075,  0.00000, 0.08475)
    r_caster_swivel:  ( 0.25075,  0.23850, 0.08475)
    l_caster_wheel :  ( 0.22735,  0.00000, 0.04125)
    r_caster_wheel :  ( 0.22735,  0.23850, 0.04125)

  Diff drive: wheel_separation=0.4247m, wheel_diameter=0.0833m
  LiDAR: YDLidar X4 — 360 samples, 0.12-10 m, 10 Hz
-->
<sdf version="1.6">
  <model name="scuttle">

    <!-- Root: ground-level reference frame -->
    <link name="base_footprint">
      <pose>0 0 0 0 0 0</pose>
    </link>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
    </link>

    <!-- Chassis -->
    <link name="chassis_link">
      <pose>0.25075 0 0.08475 0 0 0</pose>
      <inertial>
        <pose>-0.15472 0.11007 0.0067461 0 0 0</pose>
        <mass>1.314</mass>
        <inertia>
          <ixx>0.0025673</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0019434</iyy><iyz>0</iyz>
          <izz>0.0042618</izz>
        </inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://scuttle/meshes/sw/chassis_link.STL</uri></mesh>
        </geometry>
        <material><script><name>Gazebo/Grey</name></script></material>
      </visual>
      <collision name="col">
        <pose>-0.15 0.12 0 0 0 0</pose>
        <geometry><box><size>0.33 0.35 0.10</size></box></geometry>
      </collision>
    </link>

    <!-- Left wheel
         Joint origin at (0, -0.07277, 0.05925) in model frame.
         Wheel rim (CoM) is at y=+0.38 within the link frame. -->
    <link name="l_wheel">
      <pose>0 -0.07277 0.05925 0 0 0</pose>
      <inertial>
        <pose>0 0.37992 0 0 0 0</pose>
        <mass>0.2838</mass>
        <inertia>
          <ixx>0.000200549</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000230387</iyy><iyz>0</iyz>
          <izz>0.000200549</izz>
        </inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://scuttle/meshes/sw/l_wheel.STL</uri></mesh>
        </geometry>
        <material><script><name>Gazebo/Blue</name></script></material>
      </visual>
      <!-- Cylinder collision aligned to Y-axis, centred at wheel rim -->
      <collision name="col">
        <pose>0 0.37992 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.04165</radius><length>0.04</length></cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          <contact><ode><kp>500000</kp><kd>10</kd></ode></contact>
        </surface>
      </collision>
    </link>

    <!-- Right wheel
         Wheel rim (CoM) is at y=-0.38 within the link frame. -->
    <link name="r_wheel">
      <pose>0 0.31127 0.05925 0 0 0</pose>
      <inertial>
        <pose>0 -0.37992 0 0 0 0</pose>
        <mass>0.2838</mass>
        <inertia>
          <ixx>0.000200549</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000230387</iyy><iyz>0</iyz>
          <izz>0.000200549</izz>
        </inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://scuttle/meshes/sw/r_wheel.STL</uri></mesh>
        </geometry>
        <material><script><name>Gazebo/Blue</name></script></material>
      </visual>
      <collision name="col">
        <pose>0 -0.37992 0 1.5708 0 0</pose>
        <geometry>
          <cylinder><radius>0.04165</radius><length>0.04</length></cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          <contact><ode><kp>500000</kp><kd>10</kd></ode></contact>
        </surface>
      </collision>
    </link>

    <!-- LiDAR (YDLidar X4)
         Position: chassis(0.25075,0,0.08475) + lidar_joint(0.00825,0.11925,0.062025) -->
    <link name="lidar_1">
      <pose>0.259 0.11925 0.14678 0 0 0</pose>
      <inertial>
        <pose>0.0000506 0 -0.01431 0 0 0</pose>
        <mass>0.05116</mass>
        <inertia>
          <ixx>9.443e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>7.446e-06</iyy><iyz>0</iyz>
          <izz>1.468e-05</izz>
        </inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://scuttle/meshes/sw/lidar_1.STL</uri></mesh>
        </geometry>
        <material><script><name>Gazebo/DarkGrey</name></script></material>
      </visual>
      <sensor name="ydlidar_x4" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>60</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926535</min_angle>
              <max_angle>3.1415926535</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <argument>~/out:=/scan</argument>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_1</frame_name>
        </plugin>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- Caster swivels (visual only, no collision needed) -->
    <link name="l_caster_swivel">
      <pose>0.25075 0 0.08475 0 0 0</pose>
      <inertial>
        <mass>0.1833</mass>
        <inertia><ixx>2.9e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.9e-5</iyy><iyz>0</iyz><izz>4.3e-5</izz></inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://scuttle/meshes/sw/l_caster_swivel.STL</uri></mesh>
        </geometry>
        <material><script><name>Gazebo/Grey</name></script></material>
      </visual>
    </link>

    <link name="r_caster_swivel">
      <pose>0.25075 0.2385 0.08475 0 0 0</pose>
      <inertial>
        <mass>0.1833</mass>
        <inertia><ixx>2.9e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.9e-5</iyy><iyz>0</iyz><izz>4.3e-5</izz></inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://scuttle/meshes/sw/r_caster_swivel.STL</uri></mesh>
        </geometry>
        <material><script><name>Gazebo/Grey</name></script></material>
      </visual>
    </link>

    <!-- Caster wheels (sphere contact, frictionless)
         Sphere radius = caster_center_z(0.04125) - wheel_bottom_z(0.0176) = 0.02365
         This aligns caster ground contact with main wheel ground contact. -->
    <link name="l_caster_wheel">
      <pose>0.22735 0 0.04125 0 0 0</pose>
      <inertial>
        <mass>0.03431</mass>
        <inertia><ixx>6.0e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.0e-5</iyy><iyz>0</iyz><izz>6.0e-6</izz></inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://scuttle/meshes/sw/l_caster_wheel.STL</uri></mesh>
        </geometry>
        <material><script><name>Gazebo/Blue</name></script></material>
      </visual>
      <collision name="col">
        <geometry><sphere><radius>0.02365</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
          <contact><ode><kp>500000</kp><kd>10</kd></ode></contact>
        </surface>
      </collision>
    </link>

    <link name="r_caster_wheel">
      <pose>0.22735 0.2385 0.04125 0 0 0</pose>
      <inertial>
        <mass>0.03431</mass>
        <inertia><ixx>6.0e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.0e-5</iyy><iyz>0</iyz><izz>6.0e-6</izz></inertia>
      </inertial>
      <visual name="vis">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh><uri>model://scuttle/meshes/sw/r_caster_wheel.STL</uri></mesh>
        </geometry>
        <material><script><name>Gazebo/Blue</name></script></material>
      </visual>
      <collision name="col">
        <geometry><sphere><radius>0.02365</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
          <contact><ode><kp>500000</kp><kd>10</kd></ode></contact>
        </surface>
      </collision>
    </link>

    <!-- Joints -->
    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <joint name="chassis_joint" type="fixed">
      <parent>base_link</parent>
      <child>chassis_link</child>
    </joint>

    <joint name="l_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>l_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>0.0001</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="r_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>r_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><damping>0.0001</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_1</child>
    </joint>

    <joint name="l_caster_swivel_joint" type="fixed">
      <parent>base_link</parent>
      <child>l_caster_swivel</child>
    </joint>

    <joint name="r_caster_swivel_joint" type="fixed">
      <parent>base_link</parent>
      <child>r_caster_swivel</child>
    </joint>

    <joint name="l_caster_wheel_joint" type="ball">
      <parent>base_link</parent>
      <child>l_caster_wheel</child>
    </joint>

    <joint name="r_caster_wheel_joint" type="ball">
      <parent>base_link</parent>
      <child>r_caster_wheel</child>
    </joint>

    <!-- Differential Drive (Gazebo Classic) -->
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros/>
      <update_rate>30</update_rate>
      <left_joint>l_wheel_joint</left_joint>
      <right_joint>r_wheel_joint</right_joint>
      <wheel_separation>0.4247</wheel_separation>
      <wheel_diameter>0.0833</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <!-- Joint State Publisher -->
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <argument>~/out:=/joint_states</argument>
      </ros>
      <update_rate>10</update_rate>
      <joint_name>l_wheel_joint</joint_name>
      <joint_name>r_wheel_joint</joint_name>
    </plugin>

  </model>
</sdf>
