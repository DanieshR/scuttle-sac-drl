<?xml version="1.0" ?>
<robot name="scuttle" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find scuttle_description)/urdf/materials.xacro" />
    <xacro:include filename="$(find scuttle_description)/urdf/scuttle.trans" />
    <xacro:include filename="$(find scuttle_description)/urdf/scuttle.gazebo" />

    <link name="base_link"/>

    <joint name="chassis_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0.084"/>
        <parent link="base_link"/>
        <child link="chassis_link"/>
    </joint>

    <link name="chassis_link">
        <inertial>
            <origin xyz="-0.0054695 -0.0091817 -0.010754" rpy="0 0 0" />
            <mass value="1.314" />
            <inertia ixx="0.0025673" ixy="-2.165E-07" ixz="-3.2707E-06" iyy="0.0019434" iyz="1.4947E-07" izz="0.0042618" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/chassis_link.STL" scale="1 1 1"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/chassis_link.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="l_wheel_joint" type="continuous">
        <origin xyz="-0.1015 -0.19202 -0.043" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="l_wheel"/>
        <axis xyz="0 -1 0"/>
    </joint>

    <link name="l_wheel">
        <inertial>
            <origin xyz="3.6754E-08 0.37992 4.1745E-07" rpy="0 0 0" />
            <mass value="0.28379" />
            <inertia ixx="0.00020055" ixy="-9.8932E-10" ixz="-5.8603E-10" iyy="0.00023039" iyz="7.0995E-10" izz="0.00020055" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_wheel.STL" scale="1 1 1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_wheel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="r_wheel_joint" type="continuous">
        <origin xyz="-0.1015 0.19202 -0.043" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="r_wheel"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="r_wheel">
        <inertial>
            <origin xyz="-3.6753E-08 -0.37992 4.1745E-07" rpy="0 0 0" />
            <mass value="0.28379" />
            <inertia ixx="0.00020055" ixy="-9.8932E-10" ixz="5.8602E-10" iyy="0.00023039" iyz="-7.0995E-10" izz="0.00020055" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_wheel.STL" scale="1 1 1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_wheel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="lidar" type="fixed">
        <origin xyz="0.1575 0.0 0.044525" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="lidar_1"/>
    </joint>

    <link name="lidar_1">
        <inertial>
            <origin xyz="5.0563E-05 -1.8281E-07 -0.014314" rpy="0 0 0" />
            <mass value="0.051163" />
            <inertia ixx="9.4432E-06" ixy="1.1637E-07" ixz="1.1919E-08" iyy="7.4458E-06" iyz="7.6774E-11" izz="1.4683E-05" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/lidar_1.STL" scale="1 1 1"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/lidar_1.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="l_caster_swivel_joint" type="continuous">
        <origin xyz="0.14925 -0.11925 -0.0175" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="l_caster_swivel"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="l_caster_swivel">
        <inertial>
            <origin xyz="-0.00238 -0.00052795 -0.0077267" rpy="0 0 0" />
            <mass value="0.18328" />
            <inertia ixx="2.9153E-05" ixy="-1.5377E-10" ixz="-2.6781E-06" iyy="2.9247E-05" iyz="2.4884E-10" izz="4.2759E-05" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_caster_swivel.STL" scale="1 1 1"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_caster_swivel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="l_caster_wheel_joint" type="continuous">
        <origin xyz="-0.0234 0 -0.0435" rpy="0 0 0" />
        <parent link="l_caster_swivel"/>
        <child link="l_caster_wheel"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="l_caster_wheel">
        <inertial>
            <origin xyz="-2.7756E-17 2.7756E-17 6.9389E-18" rpy="0 0 0" />
            <mass value="0.034307" />
            <inertia ixx="6.0005E-06" ixy="8.899E-22" ixz="-5.9359E-25" iyy="1.0003E-05" iyz="-1.0743E-21" izz="6.0005E-06" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_caster_wheel.STL" scale="1 1 1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/l_caster_wheel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="r_caster_swivel_joint" type="continuous">
        <origin xyz="0.14925 0.11925 -0.0175" rpy="0 0 0" />
        <parent link="chassis_link"/>
        <child link="r_caster_swivel"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="r_caster_swivel">
        <inertial>
            <origin xyz="-0.00238 0.0005636 -0.0077267" rpy="0 0 0" />
            <mass value="0.18328" />
            <inertia ixx="2.9153E-05" ixy="-1.5377E-10" ixz="-2.6781E-06" iyy="2.9247E-05" iyz="2.4884E-10" izz="4.2759E-05" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_caster_swivel.STL" scale="1 1 1"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_caster_swivel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

    <joint name="r_caster_wheel_joint" type="continuous">
        <origin xyz="-0.0234 0 -0.0435" rpy="0 0 0" />
        <parent link="r_caster_swivel"/>
        <child link="r_caster_wheel"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="r_caster_wheel">
        <inertial>
            <origin xyz="-2.7756E-17 -1.3878E-17 6.9389E-18" rpy="0 0 0" />
            <mass value="0.034307" />
            <inertia ixx="6.0005E-06" ixy="1.2976E-22" ixz="-1.9759E-25" iyy="1.0003E-05" iyz="-1.6935E-22" izz="6.0005E-06" />
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_caster_wheel.STL" scale="1 1 1"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://scuttle_description/meshes/sw/r_caster_wheel.STL" scale="1 1 1"/>
            </geometry>
        </collision>
    </link>

</robot>