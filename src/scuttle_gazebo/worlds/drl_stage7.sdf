<?xml version="1.0" ?>
<!--
  DRL Stage 7 — Large arena (±2.91 m outer walls) + inner_walls_large.
  Outer walls 6 m long. Inner walls from turtlebot3_drl_world/inner_walls_large/model.sdf.
  World name "drl_stage7" used by gz service paths.
-->
<sdf version="1.8">
  <world name="drl_stage7">

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>


    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- outer_walls_large: ±2.91 m, 6 m span walls -->
    <model name="outer_walls">
      <static>true</static>
      <link name="Wall_1">
        <pose>-2.91 0 0.25 0 0 1.5708</pose>
        <collision name="collision"><geometry><box><size>6 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.15 0.5</size></box></geometry><material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material></visual>
      </link>
      <link name="Wall_2">
        <pose>0 2.91 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>6 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.15 0.5</size></box></geometry><material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material></visual>
      </link>
      <link name="Wall_3">
        <pose>2.91 0 0.25 0 0 -1.5708</pose>
        <collision name="collision"><geometry><box><size>6 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.15 0.5</size></box></geometry><material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material></visual>
      </link>
      <link name="Wall_4">
        <pose>0 -2.91 0.25 0 0 3.14159</pose>
        <collision name="collision"><geometry><box><size>6 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.15 0.5</size></box></geometry><material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- inner_walls_large — 8 segments from turtlebot3_drl_world/inner_walls_large/model.sdf -->
    <model name="inner_walls">
      <static>true</static>
      <link name="inner_wall_1">
        <pose>-2.5 -1.5 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.15 0.5</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
      <link name="inner_wall_2">
        <pose>-0.5 -2.5 0.25 0 0 -1.5708</pose>
        <collision name="collision"><geometry><box><size>1 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.15 0.5</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
      <link name="inner_wall_3">
        <pose>1.0 -1.0 0.25 0 0 1.5708</pose>
        <collision name="collision"><geometry><box><size>1 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.15 0.5</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
      <link name="inner_wall_4">
        <pose>1.2 2.4 0.25 0 0 -1.5708</pose>
        <collision name="collision"><geometry><box><size>1 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.15 0.5</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
      <link name="inner_wall_5">
        <pose>2.4 0.4 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.15 0.5</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
      <link name="inner_wall_6">
        <pose>-1.35 1.75 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.15 0.5</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
      <link name="inner_wall_7">
        <pose>-1.2 0.092 0.25 0 0 -1.5708</pose>
        <collision name="collision"><geometry><box><size>1 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.15 0.5</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
      <link name="inner_wall_8">
        <pose>0.35 0.8 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1 0.15 0.5</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="goal">
      <static>true</static>
      <pose>-99 -99 0 0 0 0</pose>
      <link name="goal_link">
        <visual name="visual">
          <pose>0 0 0.0005 0 0 0</pose>
          <geometry><cylinder><radius>0.3</radius><length>0.001</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
