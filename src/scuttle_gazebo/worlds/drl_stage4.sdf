<?xml version="1.0" ?>
<!--
  DRL Stage 4 World — SCUTTLE / turtlebot3_drlnav framework
  Matches creator's turtlebot3_drl_world layout (4.2x4.2 m navigable arena).
  Outer walls at ±2.425 m, inner_walls layout from turtlebot3_drl_world/inner_walls/model.sdf.
  World name "drl_stage4" used by gz service paths:
    /world/drl_stage4/set_pose
    /world/drl_stage4/control
  goal_box is pre-spawned at (-99,-99) and teleported by drl_gazebo.py.
-->
<sdf version="1.8">
  <world name="drl_stage4">

    <!-- Required gz-sim plugins -->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>


    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Outer boundary walls (5 m long, 0.15 m thick, 0.5 m tall)   -->
    <!-- Matches turtlebot3_drl_world/model.sdf outer walls           -->
    <!-- ============================================================ -->
    <model name="outer_walls">
      <static>true</static>

      <!-- West wall -->
      <link name="Wall_1">
        <pose>-2.425 0 0.25 0 0 1.5708</pose>
        <collision name="collision">
          <geometry><box><size>5 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 0.15 0.5</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>

      <!-- North wall -->
      <link name="Wall_2">
        <pose>0 2.425 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>5 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 0.15 0.5</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>

      <!-- East wall -->
      <link name="Wall_3">
        <pose>2.425 0 0.25 0 0 -1.5708</pose>
        <collision name="collision">
          <geometry><box><size>5 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 0.15 0.5</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>

      <!-- South wall -->
      <link name="Wall_4">
        <pose>0 -2.425 0.25 0 0 3.14159</pose>
        <collision name="collision">
          <geometry><box><size>5 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 0.15 0.5</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Inner walls (from inner_walls/model.sdf — 7 wall segments)  -->
    <!-- Positions and sizes exactly match the creator's model        -->
    <!-- ============================================================ -->
    <model name="inner_walls">
      <static>true</static>

      <link name="inner_wall_1">
        <pose>-2.0 -1.5 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>

      <link name="inner_wall_2">
        <pose>-0.5 -2.0 0.25 0 0 1.5708</pose>
        <collision name="collision">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>

      <link name="inner_wall_3">
        <pose>1.0 -1.0 0.25 0 0 1.5708</pose>
        <collision name="collision">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>

      <link name="inner_wall_4">
        <pose>1.2 1.9 0.25 0 0 -1.5708</pose>
        <collision name="collision">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>

      <link name="inner_wall_5">
        <pose>1.9 0.4 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>

      <link name="inner_wall_6">
        <pose>-0.5 1.5 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>

      <link name="inner_wall_7">
        <pose>-1.2 0.092 0.25 0 0 -1.5708</pose>
        <collision name="collision">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- Goal box — pre-spawned off-arena, teleported by drl_gazebo  -->
    <!-- ============================================================ -->
    <model name="goal">
      <static>true</static>
      <pose>-99 -99 0 0 0 0</pose>
      <link name="goal_link">
        <visual name="visual">
          <pose>0 0 0.0005 0 0 0</pose>
          <geometry>
            <cylinder><radius>0.3</radius><length>0.001</length></cylinder>
          </geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
